#!/usr/bin/env node

const CHARS = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#%^&_+-:,.?'.split('')
const DEFAULT_LENGTH = 12

run()

function run() {
    const length = process.argv[2] ? parseInt(process.argv[2]) : DEFAULT_LENGTH
    if (isNaN(length)) {
        die('invalid length', true)
    }
    process.stdout.write(generatePassword(length) + '\n')
}

function generatePassword(length) {
    let password = ''
    for (let i = 0; i < length; i++) {
        password += CHARS[Math.floor(Math.random() * CHARS.length)]
    }
    return password
}

function die (message, showUsage = false) {
	process.stderr.write(`generate-password: ${message}\n`)
	if (showUsage && process.stdout.isTTY) {
		usage()
	}
	process.exit(1)
}

function usage () {
    process.stderr.write(`usage: generate-password [length]\n`)
}
